{
  "schemaVersion": 1,
  "id": "ytlyrics",
  "version": "${version}",
  "name": "YouTube Music Lyrics",
  "description": "Shows synced lyrics for whatever is playing in YouTube Music (or any MPRIS player) as a HUD overlay.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.buffy.ytlyrics.YtLyricsMod"
    ]
  },
  "mixins": [
    {
      "config": "ytlyrics.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
